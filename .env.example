# Copie para .env (ou cadastre estas variáveis no painel da hospedagem)
NODE_ENV=production
PORT=3000

# Pasta do banco SQLite. Na hospedagem, aponte para um DISCO PERSISTENTE.
DATA_DIR=./data

# Chave de criptografia dos dados de saúde e tokens (32 bytes em base64). OBRIGATÓRIA em produção.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guarde uma cópia segura: sem ela, os dados criptografados não podem ser lidos.
DATA_ENCRYPTION_KEY=

# Primeira conta da proprietária (criada só se ainda não houver usuários). Remova a senha depois do 1º acesso.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Dra. Fernanda Zemlicski

# Fuso usado nas datas do painel e das notificações
DISPLAY_TIMEZONE=America/Sao_Paulo
